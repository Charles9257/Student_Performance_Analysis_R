#3. Using Interquartile Range (Outlier Detection)
Q1 <- quantile(df$CGPA, 0.25)
Q3 <- quantile(df$CGPA, 0.75)
IQR <- Q3 - Q1
LQR <- Q1-1.5*IQR
UQR <- Q3+1.5*IQR
Outlier <- subset(df, df$CGPA < LQR |
DF$CGPA > UQR
)
Outlier <- subset(df, df$CGPA < LQR |
df$CGPA > UQR
)
