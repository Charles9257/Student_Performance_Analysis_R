data <- read.csv("academic_performance_dataset_V2.csv")
# Remove duplicates
data <- data %>% distinct()
# Remove rows with too many missing values
data <- data[complete.cases(data), ]
# Convert categorical variables
data$Gender <- as.factor(data$Gender)
data$Prog_Code <- as.factor(data$Prog_Code)
# Z-score method for CGPA and SGPA
z_scores <- scale(data[, c("CGPA", "SGPA", "CGPA100", "CGPA200", "CGPA300", "CGPA400")])
data <- data[apply(z_scores, 1, function(x) all(abs(x) < 3)), ]
describe(data[, c("CGPA", "SGPA", "CGPA100", "CGPA200", "CGPA300", "CGPA400")])
# Normalize CGPA and SGPA
norm_data <- as.data.frame(preProcess(data[, c("CGPA", "SGPA")], method = c("range")) %>% predict(data))
# CGPA trend by year
ggplot(data, aes(x = YoG, y = CGPA)) +
geom_boxplot(fill = "skyblue") +
labs(title = "Trend of CGPA over Years")
# Anomaly: Sudden drop in SGPA
ggplot(data, aes(x = CGPA, y = SGPA)) +
geom_point(aes(color = Gender)) +
geom_smooth(method = "lm", se = FALSE, color = "red")
ggcorr(cor_data, label = TRUE)
cor_data <- data[, c("CGPA", "SGPA", "CGPA100", "CGPA200", "CGPA300", "CGPA400")]
cor_matrix <- cor(cor_data, use = "complete.obs")
ggcorr(cor_data, label = TRUE)
# CGPA trend by year
ggplot(data, aes(x = YoG, y = CGPA)) +
geom_boxplot(fill = "skyblue") +
labs(title = "Trend of CGPA over Years")
# Anomaly: Sudden drop in SGPA
ggplot(data, aes(x = CGPA, y = SGPA)) +
geom_point(aes(color = Gender)) +
geom_smooth(method = "lm", se = FALSE, color = "red")
ggcorr(cor_data, label = TRUE)
# Melt data for timeline plotting
long_data <- melt(data, id.vars = "ID_No", measure.vars = c("CGPA100", "CGPA200", "CGPA300", "CGPA400"))
ggplot(long_data, aes(x = variable, y = value, group = ID_No)) +
geom_line(alpha = 0.3) +
labs(title = "CGPA Progression Over Levels", x = "Level", y = "CGPA")
# Quantitative: ANOVA by Gender
anova_result <- aov(CGPA ~ Gender, data = data)
summary(anova_result)
# Qualitative Insight: Boxplot by Gender
ggplot(data, aes(x = Gender, y = CGPA)) +
geom_boxplot(fill = "lightgreen") +
labs(title = "Gender-based CGPA Distribution")
# 95% Confidence interval for CGPA mean
mean_cgpa <- mean(data$CGPA)
ci <- c(mean_cgpa - 1.96 * se_cgpa, mean_cgpa + 1.96 * se_cgpa)
se_cgpa <- sd(data$CGPA) / sqrt(nrow(data))
ci <- c(mean_cgpa - 1.96 * se_cgpa, mean_cgpa + 1.96 * se_cgpa)
ci
reg_model <- lm(CGPA ~ SGPA + CGPA100 + CGPA200 + CGPA300 + CGPA400, data = data)
summary(reg_model)
# Compare CGPA across different Prog_Codes (single year)
cross_section <- data %>% filter(YoG == 2022)
ggplot(cross_section, aes(x = Prog_Code, y = CGPA)) +
geom_boxplot(fill = "purple") +
labs(title = "CGPA by Program Code for Year 2022")
plot_ly(data, x = ~SGPA, y = ~CGPA, color = ~Gender, type = 'scatter', mode = 'markers') %>%
layout(title = "CGPA vs SGPA by Gender")
print(insight)
# Top 3 insights
insight <- c(
"1. CGPA shows steady progression from 100 to 400 level, except for some anomalies in CGPA300.",
"2. Gender has a small but statistically significant effect on CGPA (based on ANOVA).",
"3. Regression shows SGPA and lower level CGPAs are strong predictors of overall CGPA."
)
print(insight)
# Qualitative Insight: Boxplot by Gender
ggplot(data, aes(x = Gender, y = CGPA)) +
geom_boxplot(fill = "lightgreen") +
labs(title = "Gender-based CGPA Distribution")
# Faceted Boxplot with Filtered Programs
ggplot(program_counts, aes(x = Gender, y = CGPA, fill = Gender)) +
geom_boxplot(alpha = 0.7, outlier.color = "red", outlier.shape = 8) +
stat_summary(fun = mean, geom = "point", shape = 20, size = 3, color = "black",
position = position_dodge(width = 0.75)) +
labs(
title = "CGPA Distribution by Gender in Programs with ≥10 Students",
subtitle = "Faceted by Program Code with Means and Outliers Highlighted",
x = "Gender",
y = "Cumulative Grade Point Average (CGPA)"
) +
facet_wrap(~ Prog_Code, scales = "free_y") +
scale_fill_brewer(palette = "Set2") +
theme_minimal() +
theme(strip.text = element_text(face = "bold"))
# Filter programs with 10 or more students
program_counts <- data %>%
group_by(Prog_Code) %>%
filter(n() >= 10)
# Faceted Boxplot with Filtered Programs
ggplot(program_counts, aes(x = Gender, y = CGPA, fill = Gender)) +
geom_boxplot(alpha = 0.7, outlier.color = "red", outlier.shape = 8) +
stat_summary(fun = mean, geom = "point", shape = 20, size = 3, color = "black",
position = position_dodge(width = 0.75)) +
labs(
title = "CGPA Distribution by Gender in Programs with ≥10 Students",
subtitle = "Faceted by Program Code with Means and Outliers Highlighted",
x = "Gender",
y = "Cumulative Grade Point Average (CGPA)"
) +
facet_wrap(~ Prog_Code, scales = "free_y") +
scale_fill_brewer(palette = "Set2") +
theme_minimal() +
theme(strip.text = element_text(face = "bold"))
# Faceted Boxplot: CGPA by Gender and Program
ggplot(data, aes(x = Gender, y = CGPA, fill = Gender)) +
geom_boxplot(alpha = 0.7, outlier.color = "red", outlier.shape = 8) +
stat_summary(fun = mean, geom = "point", shape = 20, size = 3, color = "black",
position = position_dodge(width = 0.75)) +
labs(
title = "CGPA Distribution by Gender Across Programs",
subtitle = "Faceted by Program Code with Mean and Outliers Highlighted",
x = "Gender",
y = "Cumulative Grade Point Average (CGPA)"
) +
facet_wrap(~ Prog_Code, scales = "free_y") +
scale_fill_brewer(palette = "Set2") +
theme_minimal() +
theme(strip.text = element_text(face = "bold"))
# Enhanced Boxplot: CGPA Distribution by Gender
ggplot(data, aes(x = Gender, y = CGPA, fill = Gender)) +
geom_boxplot(alpha = 0.7, outlier.color = "red", outlier.shape = 8) +
stat_summary(fun = mean, geom = "point", shape = 20, size = 3, color = "black", position = position_dodge(width = 0.75)) +
labs(
title = "Distribution of CGPA by Gender",
subtitle = "Boxplot with Mean Indicator and Outliers Highlighted",
x = "Gender",
y = "Cumulative Grade Point Average (CGPA)"
) +
scale_fill_brewer(palette = "Set2") +
theme_minimal()
# Enhanced Interactive Boxplot with Hover Info
p <- ggplot(data, aes(x = Gender, y = CGPA, fill = Gender, text = paste("CGPA:", CGPA))) +
geom_boxplot(alpha = 0.7, outlier.color = "red", outlier.shape = 8) +
stat_summary(fun = mean, geom = "point", shape = 20, size = 3, color = "black",
position = position_dodge(width = 0.75)) +
labs(
title = "Distribution of CGPA by Gender",
subtitle = "Hover to View CGPA Details Including Outliers",
x = "Gender",
y = "Cumulative Grade Point Average (CGPA)"
) +
scale_fill_brewer(palette = "Set2") +
theme_minimal()
# Make it interactive
ggplotly(p, tooltip = "text")
runApp('Academic_Dashboard.R')
runApp('Academic_Dashboard.R')
